#!/bin/zsh
# launchd wrapper for Trade Hub "Claude's picks" (com.jvd.trade-hub-claude-picks,
# weekdays 03:47 AST). Play money only. Install steps: docs/london-open.md.
set -u
source ~/.zprofile >/dev/null 2>&1   # PATH (Homebrew node, ~/.local/bin) and CLAUDE_CODE_OAUTH_TOKEN
cd ~/dev/trade-hub || exit 1
echo "$(date '+%F %T') start Claude's picks (node $(node -v))"
exec nice -n 10 npx tsx scripts/claude-picks.ts
