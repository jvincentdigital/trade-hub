<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Trade Hub strategy race, London open: one tick every 15 minutes from 02:00 to
     07:00 Puerto Rico time (AST), Monday to Friday (play money only). Runs the
     same wrapper as the hourly job, which stays; the race lock makes a tick that
     overlaps another one exit quietly. The Mac's clock must be on AST.
     NOT installed by default. Install steps: docs/london-open.md -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jvd.trade-hub-race-london</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/jvdos/dev/trade-hub/scripts/launchd/run-race-tick</string></array>
  <key>WorkingDirectory</key><string>/Users/jvdos/dev/trade-hub</string>
  <key>StandardOutPath</key><string>/Users/jvdos/Library/Logs/trade-hub/race-london.log</string>
  <key>StandardErrorPath</key><string>/Users/jvdos/Library/Logs/trade-hub/race-london.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>RunAtLoad</key><false/>
  <key>StartCalendarInterval</key>
  <array>
