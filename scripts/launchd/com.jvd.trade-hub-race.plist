<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Trade Hub strategy race: one live tick every hour (play money only).
     NOT installed by default. Install steps: docs/strategy-race.md -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jvd.trade-hub-race</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>/Users/jvdos/dev/trade-hub/scripts/launchd/run-race-tick</string></array>
  <key>WorkingDirectory</key><string>/Users/jvdos/dev/trade-hub</string>
  <key>StandardOutPath</key><string>/Users/jvdos/Library/Logs/trade-hub/race.log</string>
  <key>StandardErrorPath</key><string>/Users/jvdos/Library/Logs/trade-hub/race.log</string>
  <key>ProcessType</key><string>Background</string>
  <key>RunAtLoad</key><false/>
  <key>StartInterval</key><integer>3600</integer>
</dict>
</plist>
